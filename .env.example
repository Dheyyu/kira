# Copy to .env and fill in whichever providers you have. Any that are missing
# are skipped by the router; with none configured, tasks run in simulation mode.

# Ollama (local, free). Install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Mistral (cheap, hosted). https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Prices in $ per 1M tokens, used for the spend tracker
MISTRAL_PRICE_IN=0.1
MISTRAL_PRICE_OUT=0.3

# Claude (most capable, used for hard tasks). https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_PRICE_IN=4
CLAUDE_PRICE_OUT=20

PORT=3000
HOST=127.0.0.1
